{
	"name": "switchboard-for-claude-code",
	"displayName": "Switchboard for Claude Code",
	"description": "Switch Claude Code accounts per window or repository and see every account's plan limits in the status bar. Not affiliated with Anthropic.",
	"version": "2.5.20",
	"publisher": "wheatlay",
	"author": {
		"name": "Wheatlay"
	},
	"license": "MIT",
	"icon": "images/icon.png",
	"galleryBanner": {
		"color": "#1F2328",
		"theme": "dark"
	},
	"keywords": [
		"claude code",
		"account switcher",
		"multi-account",
		"profiles",
		"usage",
		"plan limits",
		"rate limit",
		"status bar"
	],
	"engines": {
		"vscode": "^1.85.0"
	},
	"categories": [
		"Other",
		"AI"
	],
	"pricing": "Free",
	"activationEvents": [
		"*"
	],
	"main": "./extension.js",
	"capabilities": {
		"untrustedWorkspaces": {
			"supported": true
		},
		"virtualWorkspaces": false
	},
	"scripts": {
		"check": "node --check extension.js",
		"test": "node --test test/*.test.js",
		"package": "npx --yes @vscode/vsce@3 package",
		"publish": "npx --yes @vscode/vsce@3 publish"
	},
	"contributes": {
		"commands": [
			{
				"command": "claudeAccounts.switch",
				"title": "%cmd.switch%",
				"category": "Claude Accounts"
			},
			{
				"command": "claudeAccounts.add",
				"title": "%cmd.add%",
				"category": "Claude Accounts"
			},
			{
				"command": "claudeAccounts.manage",
				"title": "%cmd.manage%",
				"category": "Claude Accounts"
			},
			{
				"command": "claudeAccounts.setRepoDefault",
				"title": "%cmd.setRepoDefault%",
				"category": "Claude Accounts"
			},
			{
				"command": "claudeAccounts.clearRepoDefault",
				"title": "%cmd.clearRepoDefault%",
				"category": "Claude Accounts"
			},
			{
				"command": "claudeAccounts.toggleHistorySharing",
				"title": "%cmd.toggleHistorySharing%",
				"category": "Claude Accounts"
			},
			{
				"command": "claudeAccounts.importExisting",
				"title": "%cmd.importExisting%",
				"category": "Claude Accounts"
			},
			{
				"command": "claudeAccounts.switchToPrevious",
				"title": "%cmd.switchToPrevious%",
				"category": "Claude Accounts"
			},
			{
				"command": "claudeAccounts.addRule",
				"title": "%cmd.addRule%",
				"category": "Claude Accounts"
			},
			{
				"command": "claudeAccounts.showUsage",
				"title": "%cmd.showUsage%",
				"category": "Claude Accounts"
			},
			{
				"command": "claudeAccounts.testAutoContinue",
				"title": "Test auto-continue (experimental)",
				"category": "Claude Accounts"
			},
			{
				"command": "claudeAccounts.testScreenSaver",
				"title": "Test auto-continue behind the screen saver (experimental)",
				"category": "Claude Accounts"
			},
			{
				"command": "claudeAccounts.showArtifacts",
				"title": "%cmd.showArtifacts%",
				"category": "Claude Accounts"
			},
			{
				"command": "claudeAccounts.showLogs",
				"title": "%cmd.showLogs%",
				"category": "Claude Accounts"
			},
			{
				"command": "claudeAccounts.refreshLimits",
				"title": "Refresh plan limits (all accounts)",
				"category": "Claude Accounts"
			}
		],
		"configuration": [
			{
				"id": "claudeAccounts.switching",
				"title": "%cfg.section.switching%",
				"order": 0,
				"properties": {
					"claudeAccounts.scope": {
						"scope": "application",
						"type": "string",
						"enum": [
							"workspace",
							"user"
						],
						"enumDescriptions": [
							"%cfg.scope.workspace%",
							"%cfg.scope.user%"
						],
						"default": "workspace",
						"description": "%cfg.scope%",
						"order": 0
					},
					"claudeAccounts.reloadBehavior": {
						"scope": "application",
						"type": "string",
						"enum": [
							"ask",
							"always",
							"never"
						],
						"default": "always",
						"description": "%cfg.reloadBehavior%",
						"enumDescriptions": [
							"%cfg.reloadBehavior.ask%",
							"%cfg.reloadBehavior.always%",
							"%cfg.reloadBehavior.never%"
						],
						"order": 1
					},
					"claudeAccounts.applyToTerminal": {
						"scope": "application",
						"type": "boolean",
						"default": true,
						"markdownDescription": "%cfg.applyToTerminal%",
						"order": 2
					}
				}
			},
			{
				"id": "claudeAccounts.repoDefaults",
				"title": "%cfg.section.repoDefaults%",
				"order": 1,
				"properties": {
					"claudeAccounts.autoApplyRepoDefault": {
						"scope": "application",
						"type": "boolean",
						"default": true,
						"description": "%cfg.autoApplyRepoDefault%",
						"order": 0
					},
					"claudeAccounts.rules": {
						"scope": "application",
						"type": "array",
						"default": [],
						"description": "%cfg.rules%",
						"items": {
							"type": "object",
							"required": [
								"pattern",
								"account"
							],
							"properties": {
								"pattern": {
									"type": "string",
									"description": "%cfg.rules.pattern%"
								},
								"account": {
									"type": "string",
									"description": "%cfg.rules.account%"
								}
							}
						},
						"order": 1
					}
				}
			},
			{
				"id": "claudeAccounts.sharing",
				"title": "%cfg.section.sharing%",
				"order": 2,
				"properties": {
					"claudeAccounts.shareHistory": {
						"scope": "application",
						"type": "boolean",
						"default": false,
						"markdownDescription": "%cfg.shareHistory%",
						"order": 0
					},
					"claudeAccounts.historyItems": {
						"scope": "application",
						"type": "array",
						"items": {
							"type": "string"
						},
						"default": [
							"projects",
							"history.jsonl",
							"file-history",
							"todos",
							"plans"
						],
						"markdownDescription": "%cfg.historyItems%",
						"order": 1
					},
					"claudeAccounts.sharedItems": {
						"scope": "application",
						"type": "array",
						"items": {
							"type": "string"
						},
						"default": [
							"settings.json",
							"CLAUDE.md",
							"agents",
							"commands",
							"skills",
							"hooks",
							"output-styles",
							"plugins"
						],
						"description": "%cfg.sharedItems%",
						"order": 2
					}
				}
			},
			{
				"id": "claudeAccounts.limits",
				"title": "%cfg.section.limits%",
				"order": 3,
				"properties": {
					"claudeAccounts.planLimits": {
						"scope": "application",
						"type": "boolean",
						"default": true,
						"description": "%cfg.planLimits%",
						"order": 0
					},
					"claudeAccounts.suggestSwitchOnLimit": {
						"scope": "application",
						"type": "boolean",
						"default": true,
						"markdownDescription": "%cfg.suggestSwitchOnLimit%",
						"order": 1
					},
					"claudeAccounts.autoSwitchOnLimit": {
						"scope": "application",
						"type": "boolean",
						"default": false,
						"markdownDescription": "%cfg.autoSwitchOnLimit%",
						"order": 2
					}
				}
			},
			{
				"id": "claudeAccounts.afterReset",
				"title": "%cfg.section.afterReset%",
				"order": 4,
				"properties": {
					"claudeAccounts.remindOnLimitReset": {
						"scope": "application",
						"type": "boolean",
						"default": true,
						"markdownDescription": "%cfg.remindOnLimitReset%",
						"order": 0
					},
					"claudeAccounts.experimental.autoContinue": {
						"scope": "application",
						"type": "boolean",
						"default": false,
						"tags": [
							"experimental"
						],
						"markdownDescription": "%cfg.experimental.autoContinue%",
						"order": 1
					},
					"claudeAccounts.experimental.autoContinueIdleSeconds": {
						"scope": "application",
						"type": "number",
						"default": 60,
						"minimum": 10,
						"maximum": 3600,
						"markdownDescription": "%cfg.experimental.autoContinueIdleSeconds%",
						"order": 2
					}
				}
			},
			{
				"id": "claudeAccounts.statusBar",
				"title": "%cfg.section.statusBar%",
				"order": 5,
				"properties": {
					"claudeAccounts.statusBarStyle": {
						"scope": "application",
						"type": "string",
						"enum": [
							"name",
							"initials",
							"icon"
						],
						"enumDescriptions": [
							"%cfg.statusBarStyle.name%",
							"%cfg.statusBarStyle.initials%",
							"%cfg.statusBarStyle.icon%"
						],
						"default": "name",
						"description": "%cfg.statusBarStyle%",
						"order": 0
					},
					"claudeAccounts.showPlan": {
						"scope": "application",
						"type": "boolean",
						"default": true,
						"description": "%cfg.showPlan%",
						"order": 1
					},
					"claudeAccounts.gravatar": {
						"scope": "application",
						"type": "boolean",
						"default": false,
						"description": "%cfg.gravatar%",
						"order": 2
					}
				}
			},
			{
				"id": "claudeAccounts.artifacts",
				"title": "%cfg.section.artifacts%",
				"order": 6,
				"properties": {
					"claudeAccounts.artifactPreview": {
						"scope": "application",
						"type": "boolean",
						"default": true,
						"description": "%cfg.artifactPreview%",
						"order": 0
					},
					"claudeAccounts.artifactPreviewAutoOpen": {
						"scope": "application",
						"type": "boolean",
						"default": true,
						"markdownDescription": "%cfg.artifactPreviewAutoOpen%",
						"order": 1
					},
					"claudeAccounts.artifactPreviewPort": {
						"scope": "application",
						"type": "number",
						"default": 4999,
						"minimum": 1024,
						"maximum": 65535,
						"markdownDescription": "%cfg.artifactPreviewPort%",
						"order": 2
					}
				}
			},
			{
				"id": "claudeAccounts.promptCache",
				"title": "%cfg.section.promptCache%",
				"order": 7,
				"properties": {
					"claudeAccounts.experimental.keepCacheWarm": {
						"scope": "application",
						"type": "boolean",
						"default": false,
						"tags": [
							"experimental"
						],
						"markdownDescription": "%cfg.experimental.keepCacheWarm%",
						"order": 0
					},
					"claudeAccounts.experimental.keepCacheWarmPings": {
						"scope": "application",
						"type": "integer",
						"default": 2,
						"minimum": 1,
						"maximum": 10,
						"markdownDescription": "%cfg.experimental.keepCacheWarmPings%",
						"order": 1
					},
					"claudeAccounts.experimental.keepCacheWarmMinContext": {
						"scope": "application",
						"type": "integer",
						"default": 100000,
						"minimum": 0,
						"markdownDescription": "%cfg.experimental.keepCacheWarmMinContext%",
						"order": 2
					},
					"claudeAccounts.experimental.keepCacheWarmIdleSeconds": {
						"scope": "application",
						"type": "number",
						"default": 60,
						"minimum": 10,
						"maximum": 3300,
						"markdownDescription": "%cfg.experimental.keepCacheWarmIdleSeconds%",
						"order": 3
					},
					"claudeAccounts.experimental.afterTyping": {
						"scope": "application",
						"type": "string",
						"enum": ["screenSaver", "screenOff"],
						"default": "screenSaver",
						"markdownDescription": "%cfg.experimental.afterTyping%",
						"order": 4
					},
					"claudeAccounts.experimental.preventSleep": {
						"scope": "application",
						"type": "boolean",
						"default": false,
						"markdownDescription": "%cfg.experimental.preventSleep%",
						"order": 5
					}
				}
			},
			{
				"id": "claudeAccounts.advanced",
				"title": "%cfg.section.advanced%",
				"order": 8,
				"properties": {
					"claudeAccounts.accountsRoot": {
						"scope": "application",
						"type": "string",
						"default": "",
						"markdownDescription": "%cfg.accountsRoot%",
						"order": 0
					},
					"claudeAccounts.loginCommand": {
						"scope": "application",
						"type": "string",
						"default": "claude auth login",
						"description": "%cfg.loginCommand%",
						"order": 1
					}
				}
			}
		],
		"keybindings": [
			{
				"command": "claudeAccounts.switchToPrevious",
				"key": "ctrl+alt+shift+a",
				"mac": "cmd+alt+shift+a"
			}
		],
		"colors": [
			{
				"id": "claudeAccounts.orange",
				"description": "%color.orange%",
				"defaults": {
					"dark": "#E8915B",
					"light": "#C2621F",
					"highContrast": "#E8915B",
					"highContrastLight": "#C2621F"
				}
			},
			{
				"id": "claudeAccounts.green",
				"description": "%color.green%",
				"defaults": {
					"dark": "#7BC67E",
					"light": "#2E8B3A",
					"highContrast": "#7BC67E",
					"highContrastLight": "#2E8B3A"
				}
			},
			{
				"id": "claudeAccounts.blue",
				"description": "%color.blue%",
				"defaults": {
					"dark": "#6CA8F0",
					"light": "#1F64C2",
					"highContrast": "#6CA8F0",
					"highContrastLight": "#1F64C2"
				}
			},
			{
				"id": "claudeAccounts.purple",
				"description": "%color.purple%",
				"defaults": {
					"dark": "#B48EF0",
					"light": "#7A3FD1",
					"highContrast": "#B48EF0",
					"highContrastLight": "#7A3FD1"
				}
			},
			{
				"id": "claudeAccounts.pink",
				"description": "%color.pink%",
				"defaults": {
					"dark": "#F08DC0",
					"light": "#C2337E",
					"highContrast": "#F08DC0",
					"highContrastLight": "#C2337E"
				}
			},
			{
				"id": "claudeAccounts.yellow",
				"description": "%color.yellow%",
				"defaults": {
					"dark": "#E6C84F",
					"light": "#9A7B00",
					"highContrast": "#E6C84F",
					"highContrastLight": "#9A7B00"
				}
			},
			{
				"id": "claudeAccounts.teal",
				"description": "%color.teal%",
				"defaults": {
					"dark": "#5BC2B4",
					"light": "#16806F",
					"highContrast": "#5BC2B4",
					"highContrastLight": "#16806F"
				}
			},
			{
				"id": "claudeAccounts.red",
				"description": "%color.red%",
				"defaults": {
					"dark": "#F07B7B",
					"light": "#C22F2F",
					"highContrast": "#F07B7B",
					"highContrastLight": "#C22F2F"
				}
			}
		]
	},
	"contributors": [
		{
			"name": "Kahuê Costa",
			"url": "https://github.com/Kahuecosta/account-switcher-for-claude-code"
		}
	],
	"repository": {
		"type": "git",
		"url": "https://github.com/Wheatlay/switchboard-for-claude-code.git"
	},
	"bugs": {
		"url": "https://github.com/Wheatlay/switchboard-for-claude-code/issues"
	},
	"homepage": "https://github.com/Wheatlay/switchboard-for-claude-code#readme"
}
